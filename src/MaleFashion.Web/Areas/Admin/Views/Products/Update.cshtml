                                        foreach (var v in Model.Variants)
                                        {
                                            <tr data-id="@v.Id">
                                                <td>@v.Size</td>
                                                <td>@v.Color</td>
                                                <td><code>@v.SKU</code></td>
                                                <td>@v.StockQuantity</td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-sm btn-icon delete-variant" data-id="@v.Id" title="Delete Variant">
                                                        <i class="bx bx-trash text-danger"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr id="no-variants-row">
                                            <td colspan="5" class="text-center text-muted py-3">No variants found for this product.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Add new variant inline form -->
                        <div class="card bg-lighter border">
