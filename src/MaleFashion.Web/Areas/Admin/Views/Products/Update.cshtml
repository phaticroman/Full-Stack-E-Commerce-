                                    <div class="position-relative border rounded p-1" data-id="@img.Id" style="width:120px;">
                                        <img src="~/uploads/products/@img.ImageName" style="width:110px;height:110px;object-fit:cover;" class="rounded" />
                                        <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 p-1 delete-image" data-id="@img.Id" title="Delete Image">
                                            <i class="bx bx-x"></i>
                                        </button>
                                    </div>
                                }
                            }
                        </div>

                        <div class="row g-2 align-items-center">
                            <div class="col-sm-8 col-md-6">
                                <input type="file" id="new-image-file" class="form-control form-control-sm" accept="image/*" />
                            </div>
                            <div class="col-sm-4 col-md-2">
                                <button type="button" id="add-image-btn" class="btn btn-primary btn-sm w-100">Upload Image</button>
                            </div>
                        </div>
                        <div id="image-error" class="text-danger small mt-2"></div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function getToken() {
            return $('input[name="__RequestVerificationToken"]').first().val();
        }

        $('#add-variant-btn').on('click', function () {
            $('#variant-error').text('');

            var size = $.trim($('#variant-size').val());
            var color = $.trim($('#variant-color').val());
            var sku = $.trim($('#variant-sku').val());
            var stock = parseInt($('#variant-stock').val(), 10);

            if (!size || !color || !sku || isNaN(stock) || stock < 0) {
                $('#variant-error').text('Please provide Size, Color, SKU, and valid non-negative Stock.');
                return;
            }

            var payload = {
                ProductId: $('#variant-product-id').val(),
                Size: size,
                Color: color,
                SKU: sku,
                StockQuantity: stock,
                __RequestVerificationToken: getToken()
            };

            $.post('@Url.Action("AddVariant", "Products", new { area = "Admin" })', payload, function (res) {
                if (res.success) {
                    var v = res.variant;
                    $('#no-variants-row').remove();
                    $('#variant-table tbody').append(
                        '<tr data-id="' + v.id + '">' +
                        '<td>' + escapeHtml(v.size) + '</td>' +
                        '<td>' + escapeHtml(v.color) + '</td>' +
                        '<td><code>' + escapeHtml(v.sku) + '</code></td>' +
                        '<td>' + v.stockQuantity + '</td>' +
                        '<td class="text-center">' +
                            '<button type="button" class="btn btn-sm btn-icon delete-variant" data-id="' + v.id + '" title="Delete Variant"><i class="bx bx-trash text-danger"></i></button>' +
                        '</td>' +
                        '</tr>'
                    );
                    $('#variant-size, #variant-color, #variant-sku').val('');
                    $('#variant-stock').val(0);
                } else {
                    $('#variant-error').text(res.message || 'Error adding variant.');
                }
            }).fail(function (xhr) {
                var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : xhr.statusText;
                $('#variant-error').text('Server error adding variant: ' + msg);
            });
        });

        $('#variant-table').on('click', '.delete-variant', function () {
            if (!confirm('Are you sure you want to delete this variant?')) return;
            var id = $(this).data('id');
            var row = $(this).closest('tr');

            $.post('@Url.Action("DeleteVariant", "Products", new { area = "Admin" })', { id: id, __RequestVerificationToken: getToken() }, function (res) {
                if (res.success) {
                    row.remove();
                    if ($('#variant-table tbody tr').length === 0) {
                        $('#variant-table tbody').append('<tr id="no-variants-row"><td colspan="5" class="text-center text-muted py-3">No variants found for this product.</td></tr>');
                    }
                } else {
                    alert(res.message || 'Failed to delete variant.');
                }
            }).fail(function (xhr) {
                alert('Server error deleting variant: ' + xhr.statusText);
            });
        });


        $('#add-image-btn').on('click', function () {
            $('#image-error').text('');
            var fileInput = $('#new-image-file')[0];
            if (!fileInput.files.length) {
                $('#image-error').text('Please select an image file first.');
                return;
            }

            var formData = new FormData();
            formData.append('productId', '@Model.Id');
            formData.append('imageFile', fileInput.files[0]);
            formData.append('__RequestVerificationToken', getToken());

            $.ajax({
                url: '@Url.Action("UploadGalleryImage", "Products", new { area = "Admin" })',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        $('#image-gallery').append(
                            '<div class="position-relative border rounded p-1" data-id="' + res.imageId + '" style="width:120px;">' +
                                '<img src="/uploads/products/' + res.fileName + '" style="width:110px;height:110px;object-fit:cover;" class="rounded" />' +
                                '<button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 p-1 delete-image" data-id="' + res.imageId + '">' +
                                    '<i class="bx bx-x"></i>' +
                                '</button>' +
                            '</div>'
                        );
                        fileInput.value = '';
                    } else {
                        $('#image-error').text(res.message || 'Error uploading image.');
                    }
                },
                error: function (xhr) {
                    $('#image-error').text('An error occurred during upload: ' + xhr.statusText);
                }
            });
        });

        $('#image-gallery').on('click', '.delete-image', function () {
            if (!confirm('Are you sure you want to remove this gallery image?')) return;
            var id = $(this).data('id');
            var el = $(this).closest('div[data-id]');

            $.post('@Url.Action("DeleteGalleryImage", "Products", new { area = "Admin" })', { imageId: id, __RequestVerificationToken: getToken() }, function (res) {
                if (res.success) {
                    el.remove();
                } else {
                    alert(res.message || 'Failed to delete gallery image.');
                }
            }).fail(function (xhr) {
                alert('Server error deleting image: ' + xhr.statusText);
            });
        });

        function escapeHtml(text) {
            var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function (m) { return map[m]; });
        }
    </script>
}