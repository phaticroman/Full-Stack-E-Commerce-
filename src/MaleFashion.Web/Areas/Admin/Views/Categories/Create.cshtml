@model MaleFashion.Web.Areas.Admin.Models.CategoryModel
@{
    ViewData["Title"] = "Add Category";
}

<div class="content-wrapper">
    <div class="container-xxl flex-grow-1 container-p-y">
        <div class="row mb-6 gy-6">
            <div class="col-xxl">
                <partial name="_ResponsePartial" />
                <div class="card">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h5 class="mb-0">Add Category</h5>
                        <small class="text-body-secondary float-end">Category details</small>
                    </div>
                    <div class="card-body">

                        <form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="row mb-6">
                                <label asp-for="Name" class="col-sm-2 col-form-label">Name <span class="text-danger">*</span></label>
                                <div class="col-sm-10">
                                    <input asp-for="Name" class="form-control" placeholder="e.g. Casual Shirts" autocomplete="off" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                    <div class="form-text">
                                        Slug preview: <code id="slugPreview" class="text-primary">/category/auto-generated</code>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-6">
                                <label asp-for="Description" class="col-sm-2 col-form-label">Description</label>
                                <div class="col-sm-10">
                                    <textarea asp-for="Description" class="form-control" rows="3"
                                              placeholder="Short description shown on the storefront category page"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-6">
                                <label asp-for="ImageFile" class="col-sm-2 col-form-label">Category Image</label>
                                <div class="col-sm-10">
                                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                                    <div class="form-text">Supported formats: JPG, PNG, WEBP.</div>
                                </div>
                            </div>

                            <div class="row mb-6">
                                <label asp-for="DisplayOrder" class="col-sm-2 col-form-label">Display Order</label>
                                <div class="col-sm-10">
                                    <input asp-for="DisplayOrder" type="number" class="form-control" value="0" />
                                    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                                    <div class="form-text">Determines placement in navigation menus (lowest number appears first).</div>
                                </div>
                            </div>

                            <div class="row mb-6">
                                <label class="col-sm-2 col-form-label">Active</label>
                                <div class="col-sm-10">
                                    <div class="form-check form-switch pt-2">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" checked />
                                        <label class="form-check-label" asp-for="IsActive">Visible in storefront</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row justify-content-end">
                                <div class="col-sm-10">
                                    <button type="submit" class="btn btn-primary me-2">
                                        <i class="bx bx-save me-1"></i> Save
                                    </button>
                                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">
                                        Cancel
                                    </a>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#Name').on('input', function () {
                const text = $(this).val().trim();
                if (text.length > 0) {
                    const slug = text
                        .toLowerCase()
                        .replace(/[^\w\s-]/g, '')
                        .replace(/[\s_-]+/g, '-')
                        .replace(/^-+|-+$/g, '');
                    $('#slugPreview').text('/category/' + slug);
                } else {
                    $('#slugPreview').text('/category/auto-generated');
                }
            });
        });
    </script>
}