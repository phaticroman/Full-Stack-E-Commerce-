@model MaleFashion.Application.DTOs.OrderDto
@using MaleFashion.Domain.Enums
@{
    ViewData["Title"] = $"Order #{Model.Id.ToString()[..8].ToUpper()} Details";
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Order Details</h4>
                    <div class="breadcrumb__links">
                        <a asp-area="Customer" asp-controller="Home" asp-action="Index">Home</a>
                        <a asp-area="Customer" asp-controller="Orders" asp-action="Index">My Orders</a>
                        <span>#@Model.Id.ToString()[..8].ToUpper()</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->

<section class="spad">
    <div class="container">
        <!-- Notification Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h4 class="mb-1">
                    Order #@Model.Id.ToString()[..8].ToUpper()
                    @switch (Model.Status)
                    {
                        case OrderStatus.Pending:
                            <span class="badge bg-warning text-dark ms-2">Pending</span>
                            break;
                        case OrderStatus.Confirmed:
                            <span class="badge bg-info text-dark ms-2">Confirmed</span>
                            break;
                        case OrderStatus.Shipped:
                            <span class="badge bg-primary ms-2">Shipped</span>
                            break;
                        case OrderStatus.Delivered:
                            <span class="badge bg-success ms-2">Delivered</span>
                            break;
                        case OrderStatus.Cancelled:
                            <span class="badge bg-danger ms-2">Cancelled</span>
                            break;
                    }
                </h4>
                <p class="text-muted mb-0">Placed on @Model.OrderDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
            </div>
            
            <div class="d-flex align-items-center gap-2">
                @if (Model.Status == OrderStatus.Pending)
                {
                    <form asp-area="Customer" asp-controller="Orders" asp-action="Cancel" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <button type="submit" 
                                class="btn btn-outline-danger btn-sm"
                                onclick="return confirm('Are you sure you want to cancel this order? This action cannot be undone.');">
                            <i class="fa fa-times me-1"></i> Cancel Order
                        </button>
                    </form>
                }

                <a asp-area="Customer" asp-controller="Orders" asp-action="Index" class="btn btn-outline-dark btn-sm">
                    <i class="fa fa-arrow-left me-1"></i> Back to Orders
                </a>
            </div>
        </div>

        <div class="row">
            <!-- Left: Order Items Table -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 fw-bold">Ordered Items (@Model.Items.Count)</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Product</th>
                                        <th>Price</th>
                                        <th>Quantity</th>
                                        <th class="text-end pe-4">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <h6 class="mb-1 fw-bold">@item.ProductName</h6>
                                                <small class="text-muted">Size: @item.Size | Color: @item.Color | SKU: @item.SKU</small>
                                            </td>
                                            <td>@item.UnitPrice.ToString("C")</td>
                                            <td>@item.Quantity</td>
                                            <td class="text-end pe-4 fw-bold">@item.LineTotal.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Shipping Info & Summary Box -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 fw-bold">Shipping Address</h6>
                    </div>
                    <div class="card-body">
                        <p class="fw-bold mb-1">@Model.ShippingFullName</p>
                        <p class="mb-1 text-muted"><i class="fa fa-phone me-2"></i>@Model.ShippingPhone</p>
                        <p class="mb-1 text-muted"><i class="fa fa-envelope me-2"></i>@Model.ShippingEmail</p>
                        <p class="mb-0 text-muted"><i class="fa fa-map-marker me-2"></i>@Model.ShippingCity, @Model.ShippingPostalCode</p>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 fw-bold">Order Summary</h6>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal:</span>
                            <span class="fw-bold">@Model.Subtotal.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Shipping Fee:</span>
                            <span>@(Model.ShippingFee == 0m ? "Free" : Model.ShippingFee.ToString("C"))</span>
                        </div>
                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Discount:</span>
                                <span>-@Model.DiscountAmount.ToString("C")</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-6">Grand Total:</span>
                            <span class="text-danger fw-bold fs-5">@Model.Total.ToString("C")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>