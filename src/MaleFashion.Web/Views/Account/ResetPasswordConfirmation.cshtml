@{
    ViewData["Title"] = "Password Reset Complete";
}

<section class="checkout spad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 text-center">
                <h4 class="mb-3">Password Reset Successful</h4>
                <p>Your password has been changed. You can now sign in with your new password.</p>
                <a asp-area="" asp-controller="Account" asp-action="Login" class="site-btn mt-3">Sign In</a>
            </div>
        </div>
    </div>
</section>