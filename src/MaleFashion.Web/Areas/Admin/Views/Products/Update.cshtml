                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            
                            <input asp-for="Id" type="hidden" />
                            <input asp-for="Slug" type="hidden" />
                            <input asp-for="CurrentMainImage" type="hidden" />

                            <div class="row mb-3">
                                <label asp-for="Name" class="col-sm-2 col-form-label">Name <span class="text-danger">*</span></label>
                                <div class="col-sm-10">
                                    <input asp-for="Name" class="form-control" placeholder="e.g. Piqué Biker Jacket" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label asp-for="Description" class="col-sm-2 col-form-label">Description</label>
                                <div class="col-sm-10">
