@{
    ViewData["Title"] = "Products";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
    <style>
        .product-thumbnail {
            width: 48px;
            height: 48px;
            object-fit: cover;
            border-radius: 6px;
        }
    </style>
}

<div class="content-wrapper">
    <form id="antiforgery-form" style="display:none">
        @Html.AntiForgeryToken()
    </form>

    <div class="container-xxl flex-grow-1 container-p-y">
        <partial name="_ResponsePartial" />

        <div class="card">
            <div class="card-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <h5 class="mb-0">Products</h5>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <!-- Category Dropdown Filter -->
                    <select id="category-filter" class="form-select form-select-sm" style="width: 170px;">
                        <option value="">All Categories</option>
                        @if (ViewBag.Categories is IEnumerable<SelectListItem> categories)
                        {
                            foreach (var item in categories)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>

                    <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="bx bx-plus me-1"></i> Add Product
                    </a>
                </div>
            </div>

            <div class="card-datatable table-responsive">
                <table id="product-table" class="datatables-products table border-top">
                    <thead>
                        <tr>
                            <th style="width: 60px;">Image</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Discount</th>
                            <th>Brand</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {
            const table = $('#product-table').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetPagedProducts", "Products", new { area = "Admin" })',
                    type: 'POST',
                    contentType: 'application/json',
                    data: d => {
                        d.CategoryId = $('#category-filter').val() || null;
                        return JSON.stringify(d);
                    }
                },
                columns: [
                    {
                        data: 0,
                        render: img => img 
                            ? `<img src="/uploads/products/${img}" alt="Product" class="product-thumbnail border" />` 
                            : `<div class="avatar avatar-sm"><span class="avatar-initial rounded bg-label-secondary"><i class="bx bx-image"></i></span></div>`
                    },
                    { data: 1, render: name => `<span class="fw-semibold text-heading">${name}</span>` },
                    { data: 2 },
                    { data: 3 },
                    { data: 4, render: d => d !== '-' ? `<span class="text-success fw-semibold">${d}</span>` : `<span class="text-muted">-</span>` },
                    { data: 5 },
                    { data: 6, render: s => `<span class="badge bg-label-${s === 'Active' ? 'success' : 'secondary'}">${s}</span>` },
                    {
                        data: 7,
                        className: 'text-end',
                        render: id => `
                            <a href="/Admin/Products/Update/${id}" class="btn btn-sm btn-icon" title="Edit"><i class="bx bx-edit text-primary"></i></a>
                            <button type="button" class="btn btn-sm btn-icon delete-product" data-id="${id}" title="Delete"><i class="bx bx-trash text-danger"></i></button>
                        `
                    }
                ],
                columnDefs: [
                    { targets: [0, 6, 7], orderable: false } 
                ],
                order: [[1, 'asc']]
            });

            $('#category-filter').on('change', () => table.ajax.reload());

            $('#product-table').on('click', '.delete-product', function () {
                if (!confirm('Are you sure you want to delete this product?')) return;

                const token = $('input[name="__RequestVerificationToken"]').val();
                $(`<form method="POST" action="/Admin/Products/Delete/${$(this).data('id')}">
                    <input type="hidden" name="__RequestVerificationToken" value="${token}" />
                   </form>`).appendTo('body').submit();
            });
        });
    </script>
}