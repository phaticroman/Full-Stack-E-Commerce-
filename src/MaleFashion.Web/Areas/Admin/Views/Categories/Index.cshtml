@{
    ViewData["Title"] = "Categories";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
}

<div class="content-wrapper">
    <form id="antiforgery-form" style="display:none">
        @Html.AntiForgeryToken()
    </form>

    <div class="container-xxl flex-grow-1 container-p-y">
        <partial name="_ResponsePartial" />

        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Categories</h5>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-primary">
                    <i class="bx bx-plus me-1"></i> Add Category
                </a>
            </div>

            <div class="card-datatable table-responsive">
                <table id="category-table" class="datatables-categories table border-top">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Slug</th>
                            <th>Status</th>
                            <th>Display Order</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {$('#category-table').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Action("GetPagedCategories", "Categories", new { area = "Admin" })',
                    type: 'POST',
                    contentType: 'application/json',
                    data: d => JSON.stringify({
                        PageIndex: (d.start / d.length) + 1,
                        PageSize: d.length,
                        Search: { Value: d.search.value },
                        Order: d.order
                    })
                },
                columns: [
                    { data: 0 },
                    { data: 1, render: slug => `<code>${slug}</code>` },
                    { 
                        data: 2, 
                        render: s => `<span class="badge bg-label-${s === 'Active' ? 'success' : 'secondary'}">${s}</span>` 
                    },
                    { data: 3, className: 'text-center' },
                    {
                        data: 4,
                        className: 'text-end',
                        render: id => `
                            <a href="/Admin/Categories/Update/${id}" class="btn btn-sm btn-icon" title="Edit">
                                <i class="bx bx-edit text-primary"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-icon delete-category" data-id="${id}" title="Delete">
                                <i class="bx bx-trash text-danger"></i>
                            </button>
                        `
                    }
                ],
                columnDefs: [
                    { targets: [2, 4], orderable: false }
                ],
                order: [[0, 'asc']]
            });

            $('#category-table').on('click', '.delete-category', function () {
                if (!confirm('Are you sure you want to delete this category? This cannot be undone.')) return;

                const token = $('input[name="__RequestVerificationToken"]').val();
                $(`<form method="POST" action="/Admin/Categories/Delete/${$(this).data('id')}">
                    <input type="hidden" name="__RequestVerificationToken" value="${token}" />
                   </form>`).appendTo('body').submit();
            });
        });
    </script>
}