                                <div class="row g-2 align-items-end">
                                    <input type="hidden" id="variant-product-id" value="@Model.Id" />
                                    <div class="col-md-3">
                                        <label class="form-label small">Size <span class="text-danger">*</span></label>
                                        <input type="text" id="variant-size" class="form-control form-control-sm" placeholder="e.g. XL" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small">Color <span class="text-danger">*</span></label>
