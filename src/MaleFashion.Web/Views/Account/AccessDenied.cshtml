
@{
    ViewData["Title"] = "Access Denied";
}

<section class="checkout spad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="checkout__form text-center">

                    <div class="mb-4">
                        <i class="fa fa-lock"
                           style="font-size: 70px; color: #e53637;">
                        </i>
                    </div>

                    <h2 class="mb-3">
                        Access Denied
                    </h2>

                    <p class="mb-4">
                        Sorry, you don't have permission to access this page.
                    </p>

                    <p class="mb-4">
                        Please contact the administrator if you believe
                        you should have access.
                    </p>

                    <div class="mt-4">

                        <a asp-area="" asp-controller="Home"
                           asp-action="Index"
                           class="site-btn">
                            GO TO HOME
                        </a>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <form asp-area=""
                                  asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="site-btn"
                                  style="margin-left: 10px;">

                                <button type="submit" class="logout-link-btn">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-area="" asp-controller="Account"
                               asp-action="Login"
                               class="site-btn"
                               style="margin-left: 10px;">
                                SIGN IN
                            </a>
                        }

                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

