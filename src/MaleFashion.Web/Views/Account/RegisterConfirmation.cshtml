@{
    ViewData["Title"] = "Registration Successful";
}

<section class="checkout spad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 text-center">
                <div class="checkout__form">
                    <h4 class="mb-3">Registration Successful</h4>
                    <p>
                        We've sent a confirmation link to <strong>@ViewData["Email"]</strong>.
                        Please check your inbox and click the link to activate your account before signing in.
                    </p>
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="site-btn mt-3">Back to Sign In</a>
                </div>
            </div>
        </div>
    </div>
</section>