                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label asp-for="Brand" class="col-sm-2 col-form-label">Brand <span class="text-danger">*</span></label>
                                <div class="col-sm-10">
                                    <input asp-for="Brand" class="form-control" />
                                    <span asp-validation-for="Brand" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label asp-for="CategoryId" class="col-sm-2 col-form-label">Category <span class="text-danger">*</span></label>
                                <div class="col-sm-10">
                                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                                        <option value="">-- Select Category --</option>
                                    </select>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label asp-for="Price" class="col-sm-2 col-form-label">Price <span class="text-danger">*</span></label>
                                <div class="col-sm-4">
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="Price" type="number" step="0.01" class="form-control" />
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>

                                <label asp-for="DiscountPrice" class="col-sm-2 col-form-label">Discount Price</label>
                                <div class="col-sm-4">
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="DiscountPrice" type="number" step="0.01" class="form-control" placeholder="Optional" />
                                    </div>
                                    <span asp-validation-for="DiscountPrice" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label asp-for="MainImageFile" class="col-sm-2 col-form-label">Main Image</label>
