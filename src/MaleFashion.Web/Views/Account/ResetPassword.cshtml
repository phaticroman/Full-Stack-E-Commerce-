@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<section class="checkout spad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="checkout__form">

                    <h4 class="text-center mb-4">Reset Your Password</h4>

                    <form asp-controller="Account" asp-action="ResetPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input asp-for="Code" type="hidden" />
                        <input asp-for="Email" type="hidden" />

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="checkout__input">
                                    <p>New Password<span>*</span></p>
                                    <input asp-for="Password" type="password" placeholder="Enter new password" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="checkout__input">
                                    <p>Confirm Password<span>*</span></p>
                                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm new password" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-12 text-center mt-3">
                                <button type="submit" class="site-btn">RESET PASSWORD</button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}