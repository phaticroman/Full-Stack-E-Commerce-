@model MaleFashion.Application.DTOs.AdminOrderDetailsDto
@using MaleFashion.Domain.Enums
@{
    ViewData["Title"] = $"Order Details #{Model.Id.ToString().Substring(0, 8).ToUpper()}";
}

<div class="content-wrapper">
    <div class="container-xxl flex-grow-1 container-p-y">

        <!-- Top Header Navigation -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <h4 class="fw-bold mb-1">
                    <span class="text-muted fw-light">Orders /</span> #@Model.Id.ToString().Substring(0, 8).ToUpper()
                </h4>
                <span class="text-muted">Placed on @Model.OrderDate.ToString("dd MMMM yyyy, hh:mm tt")</span>
            </div>
            <div>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bx bx-arrow-back me-1"></i> Back to Orders
                </a>
            </div>
        </div>

        <partial name="_ResponsePartial" />

        <div class="row">
            <!-- Left Column: Items and Summary -->
            <div class="col-12 col-lg-8">
                <!-- Order Items Card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Order Items (@Model.Items.Count)</h5>
                    </div>
                    <div class="table-responsive text-nowrap">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Product Details</th>
                                    <th>Price</th>
                                    <th>Qty</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <span class="fw-semibold">@item.ProductName</span>
                                                <small class="text-muted">@item.VariantInfo | SKU: <code>@item.SKU</code></small>
                                            </div>
                                        </td>
                                        <td>@item.UnitPrice.ToString("C")</td>
                                        <td>@item.Quantity</td>
                                        <td class="text-end fw-semibold">@item.TotalPrice.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-body border-top">
                        <div class="row justify-content-end">
                            <div class="col-md-6 col-lg-5">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Subtotal:</span>
                                    <span class="fw-semibold">@Model.SubTotal.ToString("C")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Shipping Fee:</span>
                                    <span>@Model.ShippingFee.ToString("C")</span>
                                </div>
                                @if (Model.Discount > 0)
                                {
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Discount:</span>
                                        <span class="text-danger">-@Model.Discount.ToString("C")</span>
                                    </div>
                                }
                                <hr />
                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold fs-5">Total:</span>
                                    <span class="fw-bold fs-5 text-primary">@Model.Total.ToString("C")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Customer Order Notes (If Any) -->
                @if (!string.IsNullOrWhiteSpace(Model.OrderNotes))
                {
                    <div class="card mb-4 border-warning">
                        <div class="card-body">
                            <h6 class="card-title text-warning mb-2"><i class="bx bx-note me-1"></i> Customer Note:</h6>
                            <p class="card-text mb-0">@Model.OrderNotes</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Right Column: Status Change & Customer Shipping Info -->
            <div class="col-12 col-lg-4">

                <!-- Status Management Card -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Order Status</h5>
                        @switch (Model.Status)
                        {
                            case OrderStatus.Pending:
                                <span class="badge bg-label-warning">Pending</span>
                                break;
                       
                            case OrderStatus.Shipped:
                                <span class="badge bg-label-primary">Shipped</span>
                                break;
                            case OrderStatus.Delivered:
                                <span class="badge bg-label-success">Delivered</span>
                                break;
                            case OrderStatus.Cancelled:
                                <span class="badge bg-label-danger">Cancelled</span>
                                break;
                        }
                    </div>
                    <div class="card-body">
                        <form asp-area="Admin" asp-controller="Orders" asp-action="UpdateStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@Model.Id" />

                            <div class="mb-3">
                                <label class="form-label small text-muted">Update To New Status</label>
                                <select name="newStatus" class="form-select">
                                    @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                                    {
                                        <option value="@status" selected="@(Model.Status == status ? "selected" : null)">
                                            @status
                                        </option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary w-100" onclick="return confirm('Are you sure you want to change the order status?');">
                                <i class="bx bx-check me-1"></i> Update Status
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Customer Details Card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Shipping Details</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-3">
                                <span class="fw-semibold d-block">Recipient:</span>
                                <span>@Model.ShippingFullName</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-semibold d-block">Email:</span>
                                <span>@Model.ShippingEmail</span>
                            </li>
                            <li class="mb-3">
                                <span class="fw-semibold d-block">Phone:</span>
                                <span>@Model.ShippingPhoneNumber</span>
                            </li>
                            <li>
                                <span class="fw-semibold d-block">Delivery Address:</span>
                                <span class="text-body-secondary">@Model.ShippingAddress</span>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>